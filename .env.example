# kaoshi-app 后端配置示例（复制为 .env 后填写真实值）
# 部署到服务器本机的 MySQL（若 MySQL 在别的机器，把 HOST 改成对应 IP）

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=kaoshi

# 后端服务端口（项目约定避开 3000/3210，统一用 3399；仅本机监听，不对公网开放）
PORT=3399

# 微信小程序凭证 —— 启用「真·微信内容安全校验」用
# ⚠️ AppSecret 等同于密码，严禁提交到仓库；本 .env 已被 .gitignore 忽略
WX_APPID=wx3554649eef1ed7c5
WX_APPSECRET=替换为你自己的AppSecret

# 允许跨域调用接口的来源域名（逗号分隔）。
# 上线后务必保留此项，防止他人盗用你的接口；新增域名改这里即可。
ALLOWED_ORIGINS=https://malanxi.top,https://www.malanxi.top,https://kaoshi.malanxi.top

# 后台管理（/admin/ 页面 + /api/admin/* 接口）
# 账号密码走 .env；ADMIN_SECRET 用于签发登录 token，留空则每次启动随机生成（重启后需重新登录）
ADMIN_USER=admin
ADMIN_PASS=改成你自己的强密码
ADMIN_SECRET=
